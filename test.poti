imprima "Qual o primeiro número: "

var num1 := leia_numero

imprima "Qual o segundo número: "

var num2 := leia_numero

imprima "Qual a operação? "

var op := leia_texto

var resultado := 0.0

escreva "calculando resultado..."

se op == "+" entao
  resultado := num1 + num2
senaose op == "-" entao
  resultado := num1 - num2
senaose op == "*" entao
  resultado := num1 * num2
senaose op == "/" entao
  resultado := num1 / num2
fim


escreva "o resultado é {resultado}"